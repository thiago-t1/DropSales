# ============================================================
# DropSales — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env — apenas este .env.example
# ============================================================

# === Banco de Dados PostgreSQL (Neon.tech) ===
#
# Formato JDBC para Neon (SSL obrigatório):
# jdbc:postgresql://<host-pooler>/<database>?sslmode=require&channel_binding=require
#
# Como obter:
#   1. Acesse console.neon.tech → seu projeto → "Connection Details"
#   2. Selecione "JDBC" como formato de conexão
#   3. Copie host, database, username e password separadamente
#
DB_URL=jdbc:postgresql://<SEU-HOST-POOLER>.neon.tech/<SEU-DATABASE>?sslmode=require&channel_binding=require
DB_USERNAME=<SEU-USUARIO-NEON>
DB_PASSWORD=<SUA-SENHA-NEON>

# === JWT ===
# OBRIGATÓRIO: Gere um secret seguro com no mínimo 256 bits (32 bytes).
#
# Linux/Mac:
#   openssl rand -base64 32
#
# Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#
JWT_SECRET=<MINIMO-32-CARACTERES-ALEATORIOS-AQUI>
JWT_EXPIRATION_MS=86400000

# === CORS ===
# Em produção, coloque a URL exata do seu frontend no Render/Vercel/etc.
# Para múltiplos domínios, separe com vírgula (sem espaços):
# CORS_ALLOWED_ORIGINS=https://dropsales.vercel.app,https://www.dropsales.com.br
CORS_ALLOWED_ORIGINS=http://localhost:4200

# === Servidor ===
SERVER_PORT=8080

# === Spring Profile ===
# Valores: dev | prod
# Em produção no Render, defina como: prod
SPRING_PROFILES_ACTIVE=dev

# === JPA / Hibernate ===
# SEGURANÇA: Em produção, use 'validate' (não 'update').
# O valor 'update' altera o schema automaticamente — perigoso em prod.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
