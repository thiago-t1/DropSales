# ============================================================
# DropSales — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env — apenas este .env.example
# ============================================================

# === Banco de Dados PostgreSQL ===
DB_URL=jdbc:postgresql://localhost:5432/dropsales_db
DB_USERNAME=postgres
DB_PASSWORD=SUBSTITUA_AQUI

# === JWT ===
# Gere um secret seguro com:
#   Linux/Mac:  openssl rand -base64 32
#   Windows PS: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
JWT_SECRET=SUBSTITUA_AQUI_COM_256_BITS_ALEATORIOS
JWT_EXPIRATION_MS=86400000

# === CORS ===
# Em produção, use o domínio real da aplicação.
# Para múltiplos domínios, separe com vírgula:
# CORS_ALLOWED_ORIGINS=https://app.dropsales.com.br,https://admin.dropsales.com.br
CORS_ALLOWED_ORIGINS=http://localhost:4200

# === Servidor ===
SERVER_PORT=8080

# === Spring Profile ===
# Valores: dev | prod
SPRING_PROFILES_ACTIVE=dev
